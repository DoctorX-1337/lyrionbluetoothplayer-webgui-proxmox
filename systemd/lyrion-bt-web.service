[Unit]
Description=Lyrion Bluetooth Player Web Interface
After=lyrion-bt-manager.service
Wants=lyrion-bt-manager.service

[Service]
Type=simple
ExecStart=/opt/lyrion-bt-player/.venv/bin/uvicorn app.web:create_app --factory --host 0.0.0.0 --port 8080 --no-access-log --log-level warning
Environment=LYRION_BT_CONFIG=/etc/lyrion-bt-player/config.toml
WorkingDirectory=/opt/lyrion-bt-player
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
